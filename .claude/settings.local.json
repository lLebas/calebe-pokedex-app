{
  "permissions": {
    "allow": [
      "PowerShell(git init)",
      "PowerShell(winget install --id Git.Git -e --source winget --accept-package-agreements --accept-source-agreements --silent)",
      "PowerShell(winget install --id GitHub.cli -e --source winget --accept-package-agreements --accept-source-agreements --silent)",
